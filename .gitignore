
# Exported mkcert root CA (generated by deploy.rb; copy to browser machines, do not commit)
carbide-rootCA.pem

# Frozen deploy configs (deploy.rb --yaml-out, scripts/configure.rb). These carry
# cluster.token — a credential that joins a node as a control-plane member.
/cluster*.yaml
carbide2-bridge*/
carbide2-site/
carbide2-docs/
legacy*/

# Agent-local state (memories, etc.) — never commit
/.carbide/
