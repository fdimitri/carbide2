#!/usr/bin/env bash
# build-client — build a carbide2-client SHA and inject it into the MinIO
# static tier (the ONLY place a built client lives).
#
# Each build is compiled with an ABSOLUTE Vite base of
#   /clients/<family>/<sha>/
# so its asset URLs point straight at the static tier regardless of which
# workspace/control pod's loader serves the index.html. The build (index.html,
# assets/*, plus a generated manifest.json) is uploaded to the MinIO `clients`
# bucket under key <family>/<sha>/…, which the tier then serves at the matching
# /clients/<family>/<sha>/… path.
#
# Nothing is baked into any image — adding a client at runtime is just this
# upload. The client picker (GET /api/clients) then offers the new build.
#
# Both the workspace SPA and the control dashboard are built from the SAME
# carbide2-client source; they differ only by VITE_CARBIDE_MODE, which the
# --mode flag selects. Each mode is a distinct static-tier family:
#   --mode workspace  -> family carbide2-client   (VITE_CARBIDE_MODE=workspace)
#   --mode control    -> family carbide2-control  (VITE_CARBIDE_MODE=control)
#
# Usage:
#   scripts/build-client                       # workspace family, pinned HEAD
#   scripts/build-client <sha|ref>             # workspace family, any client commit
#   scripts/build-client --mode control        # control family, pinned HEAD
#   scripts/build-client --mode control <ref>  # control family, any client commit
#   CARBIDE_CLIENT_LABEL="rc3" scripts/build-client <ref>
#
# Env:
#   CARBIDE_MINIO_NS   (default carbide-system)  namespace of the MinIO service
#   CARBIDE_MINIO_SVC  (default minio)           MinIO service name
#   CARBIDE_FLOOR_PROTOCOL / _SERVER / _WORKER   optional manifest floors
#
# Requires: git, docker (BuildKit), kubectl with cluster access, and the MinIO
# client. NOTE: on Debian/Ubuntu the `mc` package is GNU Midnight Commander, a
# file manager — NOT the MinIO client. Install the MinIO client under a
# non-colliding name (e.g. `mcli`) or set CARBIDE_MC to its path.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# The client source is always the carbide2-client submodule; the FAMILY that a
# build is published under is derived from --mode below.
SRC="$ROOT/carbide2-client"
NS="${CARBIDE_MINIO_NS:-carbide-system}"
MINIO_SVC="${CARBIDE_MINIO_SVC:-minio}"
NODE_IMAGE="${CARBIDE_NODE_IMAGE:-node:22-alpine}"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# --- args: [--mode workspace|control] [<ref>] ------------------------------
MODE="workspace"
REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) MODE="${2:?--mode needs a value}"; shift 2 ;;
    --mode=*) MODE="${1#--mode=}"; shift ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed -e '/^set -euo/d' -e 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown flag: $1" ;;
    *) [ -z "$REF" ] || die "unexpected extra arg: $1"; REF="$1"; shift ;;
  esac
done
REF="${REF:-HEAD}"

case "$MODE" in
  workspace) FAMILY="carbide2-client" ;;
  control)   FAMILY="carbide2-control" ;;
  *) die "invalid --mode '$MODE' (want: workspace | control)" ;;
esac

# Resolve the MinIO client. Accept an explicit CARBIDE_MC, else probe common
# names, verifying each is really the MinIO client (its --version mentions
# "minio") so we never mistake Midnight Commander's `mc` for it.
is_minio_mc() { command -v "$1" >/dev/null 2>&1 && "$1" --version 2>&1 | grep -qi minio; }
MC=""
for cand in "${CARBIDE_MC:-}" mcli mc "$HOME/.local/bin/mcli"; do
  [ -n "$cand" ] || continue
  if is_minio_mc "$cand"; then MC="$cand"; break; fi
done
[ -n "$MC" ] || die "MinIO client not found (tried mcli, mc). Install it or set CARBIDE_MC. On Debian, 'mc' is Midnight Commander, not MinIO."

[ -d "$SRC" ] || die "client submodule missing: $SRC (git submodule update --init)"
command -v docker  >/dev/null || die "docker not found"
command -v kubectl >/dev/null || die "kubectl not found"

# Resolve the ref to a full commit, fetching from origin if it isn't local yet.
SHA="$(git -C "$SRC" rev-parse --verify --quiet "${REF}^{commit}" || true)"
if [ -z "$SHA" ]; then
  log "ref '$REF' not present locally — fetching origin"
  git -C "$SRC" fetch --quiet origin || true
  SHA="$(git -C "$SRC" rev-parse --verify --quiet "${REF}^{commit}" || true)"
fi
[ -n "$SHA" ] || die "cannot resolve client ref '$REF' to a commit"

SHORT="$(git -C "$SRC" rev-parse --short=12 "$SHA")"
BASE="/clients/$FAMILY/$SHORT/"
BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
# Git commit time (UTC Zulu) is the ONLY reliable "newness" key: build_time is
# just when this script ran, so building an OLD commit today makes it look newer
# than the tip. Loaders sort on commit_time to pick the real newest build.
COMMIT_TIME="$(TZ=UTC git -C "$SRC" show -s --date=format-local:%Y-%m-%dT%H:%M:%SZ --format=%cd "$SHA")"
LABEL="${CARBIDE_CLIENT_LABEL:-$SHORT}"

log "building $FAMILY @ $SHORT (mode=$MODE, base=$BASE)"

WORKTREE="$(mktemp -d /tmp/carbide-client.XXXXXX)"
PF_PID=""
cleanup() {
  [ -n "$PF_PID" ] && kill "$PF_PID" >/dev/null 2>&1 || true
  git -C "$SRC" worktree remove --force "$WORKTREE" >/dev/null 2>&1 || true
  rm -rf "$WORKTREE" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# Materialize the exact commit in a throwaway worktree so we never disturb the
# submodule's checked-out state.
git -C "$SRC" worktree add --detach --force "$WORKTREE" "$SHA" >/dev/null

# Build in a container matching the Dockerfile's dashboard-build stage.
# Run as the host user so everything the build writes (dist/, node_modules,
# manifest.json below) is owned by us, not root — otherwise the host-side steps
# that follow can't write into the container-created dist/. HOME=/app keeps
# npm's cache inside the (host-owned, writable) worktree.
log "npm ci + vite build (node container)"
docker run --rm \
  --user "$(id -u):$(id -g)" \
  -e HOME=/app \
  -v "$WORKTREE":/app -w /app \
  -e VITE_CARBIDE_MODE="$MODE" \
  -e VITE_APP_CLIENT_SHA="$SHORT" \
  -e VITE_APP_BUILD_TIME="$BUILD_TIME" \
  "$NODE_IMAGE" \
  sh -c "npm ci --no-audit --no-fund && npx vite build --base=$BASE"

DIST="$WORKTREE/dist"
[ -f "$DIST/index.html" ] || die "build produced no dist/index.html"

# Manifest travels with the build; the registry/loader reads it to label the
# build in the picker and (later) enforce compatibility floors.
floors_json() {
  local out="{}" first=1 add
  add() { [ -n "$2" ] || return 0; out="${out%\}}"; [ $first -eq 1 ] && first=0 || out="$out,"; out="$out\"$1\":\"$2\"}"; }
  add protocol "${CARBIDE_FLOOR_PROTOCOL:-}"
  add server   "${CARBIDE_FLOOR_SERVER:-}"
  add worker   "${CARBIDE_FLOOR_WORKER:-}"
  printf '%s' "$out"
}
cat > "$DIST/manifest.json" <<JSON
{
  "family": "$FAMILY",
  "mode": "$MODE",
  "sha": "$SHORT",
  "full_sha": "$SHA",
  "label": "$LABEL",
  "build_time": "$BUILD_TIME",
  "commit_time": "$COMMIT_TIME",
  "base": "$BASE",
  "floors": $(floors_json)
}
JSON

# Upload to MinIO over a kubectl port-forward. Reads are anonymous (the tier),
# but uploads use the root credentials from the k8s secret.
log "uploading to minio://clients/$FAMILY/$SHORT/  (via $MC)"
MINIO_USER="$(kubectl -n "$NS" get secret minio-credentials -o jsonpath='{.data.root-user}' | base64 -d)"
MINIO_PASS="$(kubectl -n "$NS" get secret minio-credentials -o jsonpath='{.data.root-password}' | base64 -d)"

# Use a per-run config dir so we never touch the user's real mc aliases.
MC_CFG="$WORKTREE/.mc"
mc_run() { "$MC" --config-dir "$MC_CFG" "$@"; }

kubectl -n "$NS" port-forward "svc/$MINIO_SVC" 9000:9000 >/tmp/carbide-minio-pf.log 2>&1 &
PF_PID=$!

n=0
until mc_run alias set carbide-tier http://127.0.0.1:9000 "$MINIO_USER" "$MINIO_PASS" >/dev/null 2>&1; do
  n=$((n+1)); [ "$n" -gt 30 ] && die "minio unreachable via port-forward (see /tmp/carbide-minio-pf.log)"
  sleep 1
done
mc_run mirror --overwrite --remove "$DIST" "carbide-tier/clients/$FAMILY/$SHORT"

# Regenerate the registry index. The in-cluster loaders (server + control) can't
# list the bucket over anonymous GET, so they read this single object to know
# which builds exist and which is newest per family. It's rebuilt from scratch
# each upload (authoritative + self-healing) by listing every build's
# manifest.json with the authenticated client and aggregating with jq.
log "regenerating clients/registry.json index"
manifest_keys="$(mc_run --json ls --recursive "carbide-tier/clients/" \
  | jq -r 'select(.key | endswith("manifest.json")) | .key')"

registry_tmp="$WORKTREE/registry.json"
if [ -n "$manifest_keys" ]; then
  # Cat each manifest, then group by family and sort newest-first by commit_time
  # (git commit date), falling back to build_time for pre-commit_time manifests.
  # shellcheck disable=SC2086
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    mc_run cat "carbide-tier/clients/$key"
  done <<< "$manifest_keys" \
    | jq -s '{
        generated: (now | todateiso8601),
        families: (
          group_by(.family)
          | map({ (.[0].family): (sort_by(.commit_time // .build_time) | reverse) })
          | add
        )
      }' > "$registry_tmp"
else
  printf '{"generated":"%s","families":{}}' "$BUILD_TIME" > "$registry_tmp"
fi

mc_run cp "$registry_tmp" "carbide-tier/clients/registry.json" >/dev/null

log "done: $FAMILY @ $SHORT is available at /clients/$FAMILY/$SHORT/ (label: $LABEL)"
